---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  eager?: boolean;
  headingLevel?: 2 | 3;
}

const { project, eager = false, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 3 ? 'h3' : 'h2';
---

<article>
  <a href={`/projects/${project.id}`}>
    <Image
      src={project.data.cover}
      alt=""
      width={960}
      height={720}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
    <Heading>{project.data.title}</Heading>
    <p>{project.data.client} · {project.data.year}</p>
  </a>
</article>

<style>
  article a {
    display: grid;
    gap: 0.85rem;
    text-decoration: none;
  }

  img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: color-mix(in srgb, var(--color-ink) 8%, var(--color-canvas));
  }

  :is(h2, h3) {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.875rem;
  }
</style>
