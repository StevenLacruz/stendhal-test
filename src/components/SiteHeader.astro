---
import { getSettings } from '../lib/content';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const settings = await getSettings();
const onHome = currentPath === '/';

const links = [
  { id: 'inicio', label: 'Inicio' },
  { id: 'sobre', label: 'Sobre nosotros' },
  { id: 'artistas', label: 'Artistas' },
  { id: 'producciones', label: 'Producciones' },
  { id: 'a-medida', label: 'A medida' },
  { id: 'inspirate', label: 'Inspírate' },
  { id: 'contacto', label: 'Contacto' },
];

const hrefFor = (id: string) => (onHome ? `#${id}` : `/#${id}`);
---

<header class="masthead" data-masthead>
  <div class="mast-links">
    <a class="brand" href={onHome ? '#inicio' : '/'} aria-label="El Efecto Stendhal">
      <img src="/brand/logo.png" width="937" height="542" alt="" />
    </a>
    <a class="mast-mail tap-target" href={`mailto:${settings.data.email}`}>{settings.data.email}</a>
  </div>
  <div class="mast-actions">
    {
      onHome && (
        <button
          class="audio-toggle is-live tap-target"
          type="button"
          data-sound
          aria-label="Silenciar"
          aria-pressed="true"
        >
          <span class="audio-toggle__dot" aria-hidden="true"></span>
          <span class="audio-toggle__label" data-sound-label>Sonido activo</span>
          <svg class="audio-toggle__icon audio-toggle__icon--off" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M11 5 6 9H3v6h3l5 4V5Z"></path>
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              d="m22 9-6 6M16 9l6 6"></path>
          </svg>
          <svg class="audio-toggle__icon audio-toggle__icon--on" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M11 5 6 9H3v6h3l5 4V5Z"></path>
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              d="M15.5 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12"></path>
          </svg>
        </button>
      )
    }
    {onHome && <span class="mast-rule" aria-hidden="true"></span>}
    <button
      class="menu-toggle tap-target"
      type="button"
      aria-expanded="false"
      aria-controls="navegacion"
      data-menu-toggle
    >
      <span class="label-open">Menú</span>
      <span class="label-close">Cerrar</span>
    </button>
  </div>
  <nav id="navegacion" aria-label="Navegación principal" data-menu-panel>
    <ul>
      {
        links.map((link) => (
          <li>
            <a
              class="tap-target"
              href={hrefFor(link.id)}
              aria-current={link.id === 'inicio' && onHome ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector('[data-masthead]');
  const toggle = document.querySelector('[data-menu-toggle]');
  const panel = document.querySelector('[data-menu-panel]');

  if (header instanceof HTMLElement && toggle instanceof HTMLButtonElement && panel) {
    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      document.body.classList.toggle('menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });

    const syncSolid = () => {
      header.classList.toggle('is-solid', window.scrollY > window.innerHeight * 0.7);
    };

    syncSolid();
    document.addEventListener('scroll', syncSolid, { passive: true });
  }

  const video = document.querySelector('[data-hero-video]');
  const soundBtn = document.querySelector('[data-sound]');
  const soundLabel = document.querySelector('[data-sound-label]');

  if (video instanceof HTMLVideoElement && soundBtn instanceof HTMLButtonElement) {
    let wantsSound = true;

    const syncSoundUi = () => {
      soundBtn.classList.toggle('is-live', wantsSound);
      soundBtn.setAttribute('aria-pressed', String(wantsSound));
      soundBtn.setAttribute('aria-label', wantsSound ? 'Silenciar' : 'Activar sonido');
      if (soundLabel) soundLabel.textContent = wantsSound ? 'Sonido activo' : 'Audio';
    };

    const setMuted = (muted: boolean) => {
      video.muted = muted;
      video.defaultMuted = muted;
      if (muted) video.setAttribute('muted', '');
      else {
        video.removeAttribute('muted');
        video.volume = 1;
      }
      syncSoundUi();
    };

    const tryPlay = async () => {
      if (wantsSound) {
        setMuted(false);
        try {
          await video.play();
          return;
        } catch {
          /* El navegador bloquea el audio automático: el vídeo sigue y el sonido entra con el primer gesto. */
        }
      }

      setMuted(true);
      try {
        await video.play();
      } catch {
        /* Autoplay bloqueado. */
      }
    };

    const unlockSound = () => {
      if (!wantsSound || !video.muted) return;
      setMuted(false);
      void video.play();
    };

    video.volume = 1;
    setMuted(!wantsSound);
    void tryPlay();

    const unlockEvents = ['pointerdown', 'keydown', 'touchstart'] as const;
    const onFirstGesture = () => {
      unlockSound();
      unlockEvents.forEach((type) => {
        window.removeEventListener(type, onFirstGesture, true);
      });
    };
    unlockEvents.forEach((type) => {
      window.addEventListener(type, onFirstGesture, { capture: true });
    });

    soundBtn.addEventListener('click', (event) => {
      event.stopPropagation();
      wantsSound = !wantsSound;
      setMuted(!wantsSound);
      if (wantsSound) void video.play();
    });

    video.addEventListener('volumechange', syncSoundUi);
    syncSoundUi();
  }
</script>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: max(0.7rem, env(safe-area-inset-top)) var(--spacing-gutter) 0.7rem;
    background: color-mix(in srgb, var(--color-canvas) 72%, transparent);
    backdrop-filter: blur(16px);
  }

  :global(.is-overlay) .masthead {
    position: fixed;
    inset-inline: 0;
    background: linear-gradient(
      to bottom,
      rgba(10, 9, 6, 0.55) 0%,
      rgba(10, 9, 6, 0.12) 70%,
      transparent 100%
    );
    backdrop-filter: blur(10px);
  }

  :global(.is-overlay) .masthead.is-solid,
  :global(.is-overlay) .masthead.is-open {
    background: var(--color-canvas);
    backdrop-filter: none;
  }

  .mast-links {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem 1.6rem;
  }

  .brand,
  .mast-mail,
  .menu-toggle,
  nav a {
    text-decoration: none;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .brand img {
    display: block;
    width: clamp(4.25rem, 9vw, 5.35rem);
    height: auto;
  }

  .mast-mail,
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: 0.18em;
    line-height: 1;
    text-transform: uppercase;
  }

  .mast-actions {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 2vw, 1.15rem);
  }

  .mast-rule {
    width: 1px;
    height: 0.9rem;
    background: rgba(255, 255, 255, 0.45);
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font-family: inherit;
    cursor: pointer;
  }

  .audio-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    font-family: inherit;
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: 0.18em;
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
  }

  .audio-toggle:hover,
  .audio-toggle:focus-visible,
  .audio-toggle.is-live {
    color: #fff;
  }

  .audio-toggle__dot {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .audio-toggle__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: currentColor;
    opacity: 0;
  }

  .audio-toggle.is-live .audio-toggle__dot::after {
    animation: ping 1.6s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  .audio-toggle__label {
    display: none;
  }

  .audio-toggle__icon {
    display: none;
    width: 14px;
    height: 14px;
  }

  .audio-toggle:not(.is-live) .audio-toggle__icon--off,
  .audio-toggle.is-live .audio-toggle__icon--on {
    display: block;
  }

  @keyframes ping {
    75%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  @media (min-width: 720px) {
    .audio-toggle__label {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .audio-toggle.is-live .audio-toggle__dot::after {
      animation: none;
    }
  }

  .label-close {
    display: none;
  }

  .is-open .label-open {
    display: none;
  }

  .is-open .label-close {
    display: inline;
  }

  nav {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: none;
    align-items: flex-start;
    padding: 18vh var(--spacing-gutter) max(2.5rem, env(safe-area-inset-bottom));
    background: var(--color-canvas);
  }

  .is-open nav {
    display: flex;
  }

  ul {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.8vw, 2.15rem);
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .is-open nav a {
    animation: nav-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .is-open nav li:nth-child(2) a { animation-delay: 0.04s; }
  .is-open nav li:nth-child(3) a { animation-delay: 0.08s; }
  .is-open nav li:nth-child(4) a { animation-delay: 0.12s; }
  .is-open nav li:nth-child(5) a { animation-delay: 0.16s; }
  .is-open nav li:nth-child(6) a { animation-delay: 0.2s; }
  .is-open nav li:nth-child(7) a { animation-delay: 0.24s; }

  @keyframes nav-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  @media (max-width: 720px) {
    .mast-mail {
      display: none;
    }
  }
</style>
