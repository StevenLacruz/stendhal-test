---
import { getSettings } from '../lib/content';
import { menuHref, menuSections } from '../data/menu';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const settings = await getSettings();
const path = currentPath.length > 1 ? currentPath.replace(/\/$/, '') : currentPath;
const onHome = path === '/';

const linksBeforeMenu = [
  { href: '/', label: 'Inicio', current: onHome },
  { href: '/#sobre', label: 'Sobre nosotros', current: false },
];
const linksAfterMenu = [
  { href: '/#producciones', label: 'Producciones', current: false },
  { href: '/#a-medida', label: 'A medida', current: false },
  { href: '/#inspirate', label: 'Inspírate', current: false },
  { href: '/#contacto', label: 'Contacto', current: false },
];
const onMenu = path === '/menu' || path.startsWith('/menu/');
---

<header class="masthead" data-masthead>
  <div class="mast-links">
    <a class="brand" href={onHome ? '#inicio' : '/'} aria-label="El Efecto Stendhal">
      <img src="/brand/logo.png" width="937" height="542" alt="" />
    </a>
    <a class="mast-mail tap-target" href={`mailto:${settings.data.email}`}>{settings.data.email}</a>
  </div>
  <div class="mast-actions">
    {
      onHome && (
        <button
          class="audio-toggle is-live tap-target"
          type="button"
          data-sound
          aria-label="Silenciar"
          aria-pressed="true"
        >
          <span class="audio-toggle__dot" aria-hidden="true"></span>
          <span class="audio-toggle__label" data-sound-label>Sonido activo</span>
          <svg class="audio-toggle__icon audio-toggle__icon--off" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M11 5 6 9H3v6h3l5 4V5Z"></path>
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              d="m22 9-6 6M16 9l6 6"></path>
          </svg>
          <svg class="audio-toggle__icon audio-toggle__icon--on" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M11 5 6 9H3v6h3l5 4V5Z"></path>
            <path
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              d="M15.5 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12"></path>
          </svg>
        </button>
      )
    }
    {onHome && <span class="mast-rule" aria-hidden="true"></span>}
    <button
      class="menu-toggle tap-target"
      type="button"
      aria-expanded="false"
      aria-controls="navegacion"
      data-menu-toggle
    >
      <span class="label-open">Menú</span>
      <span class="label-close">Cerrar</span>
    </button>
  </div>
  <nav id="navegacion" aria-label="Navegación principal" data-menu-panel hidden>
    <ul class="primary-nav">
      {
        linksBeforeMenu.map((link) => (
          <li>
            <a class="tap-target" href={link.href} aria-current={link.current ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
      <li class:list={['nav-group', onMenu && 'is-current']} data-nav-group>
        <button
          class="nav-section-toggle tap-target"
          type="button"
          aria-expanded="false"
          aria-controls="categorias-lo-que-hacemos"
          data-nav-section-toggle
        >
          <span>Lo que hacemos</span>
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M3 6.25 8 11l5-4.75" />
          </svg>
        </button>
        <ul id="categorias-lo-que-hacemos" class="nav-submenu" data-nav-submenu hidden>
          {
            menuSections.map((section) => (
              <li>
                <a
                  href={menuHref(section.slug)}
                  aria-current={path === menuHref(section.slug) ? 'page' : undefined}
                >
                  {section.title}
                </a>
              </li>
            ))
          }
        </ul>
      </li>
      {
        linksAfterMenu.map((link) => (
          <li>
            <a class="tap-target" href={link.href}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector('[data-masthead]');
  const toggle = document.querySelector('[data-menu-toggle]');
  const panel = document.querySelector('[data-menu-panel]');
  const sectionToggle = document.querySelector('[data-nav-section-toggle]');
  const submenu = document.querySelector('[data-nav-submenu]');

  if (header instanceof HTMLElement && toggle instanceof HTMLButtonElement && panel instanceof HTMLElement) {
    const focusableSelector =
      'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';
    let lastFocused: HTMLElement | null = null;

    const getInertTargets = () =>
      [...document.body.children].filter(
        (node): node is HTMLElement => node instanceof HTMLElement && node !== header,
      );

    const setSectionOpen = (open: boolean) => {
      if (!(sectionToggle instanceof HTMLButtonElement) || !(submenu instanceof HTMLElement)) return;
      sectionToggle.setAttribute('aria-expanded', String(open));
      submenu.hidden = !open;
    };

    const trapFocus = (event: KeyboardEvent) => {
      if (event.key !== 'Tab' || !header.classList.contains('is-open')) return;
      const focusables = [toggle, ...panel.querySelectorAll<HTMLElement>(focusableSelector)].filter(
        (el) => el instanceof HTMLElement && !el.hasAttribute('disabled') && el.offsetParent !== null,
      );
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (!first || !last) return;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    };

    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      document.body.classList.toggle('menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;

      for (const target of getInertTargets()) {
        if (open) target.setAttribute('inert', '');
        else target.removeAttribute('inert');
      }

      if (open) {
        lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : toggle;
        const firstLink = panel.querySelector<HTMLElement>('a, button');
        window.setTimeout(() => (firstLink ?? toggle).focus(), 0);
        document.addEventListener('keydown', trapFocus);
      } else {
        setSectionOpen(false);
        document.removeEventListener('keydown', trapFocus);
        (lastFocused ?? toggle).focus();
      }
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    if (sectionToggle instanceof HTMLButtonElement && submenu instanceof HTMLElement) {
      sectionToggle.addEventListener('click', () => {
        setSectionOpen(sectionToggle.getAttribute('aria-expanded') !== 'true');
      });
    }

    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        window.setTimeout(() => setOpen(false), 0);
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.classList.contains('is-open')) {
        event.preventDefault();
        setOpen(false);
      }
    });

    const syncSolid = () => {
      header.classList.toggle('is-solid', window.scrollY > window.innerHeight * 0.7);
    };

    syncSolid();
    document.addEventListener('scroll', syncSolid, { passive: true });
  }

  const video = document.querySelector('[data-hero-video]');
  const soundBtn = document.querySelector('[data-sound]');
  const soundLabel = document.querySelector('[data-sound-label]');

  if (video instanceof HTMLVideoElement && soundBtn instanceof HTMLButtonElement) {
    let wantsSound = true;
    const startAt = Number(video.dataset.startAt ?? 0);

    const cueOpeningFrame = () => {
      if (Number.isFinite(startAt) && startAt > 0 && video.currentTime < 0.5) {
        video.currentTime = startAt;
      }
    };

    if (video.readyState >= HTMLMediaElement.HAVE_METADATA) {
      cueOpeningFrame();
    } else {
      video.addEventListener('loadedmetadata', cueOpeningFrame, { once: true });
    }

    const syncSoundUi = () => {
      soundBtn.classList.toggle('is-live', wantsSound);
      soundBtn.setAttribute('aria-pressed', String(wantsSound));
      soundBtn.setAttribute('aria-label', wantsSound ? 'Silenciar' : 'Activar sonido');
      if (soundLabel) soundLabel.textContent = wantsSound ? 'Sonido activo' : 'Audio';
    };

    const setMuted = (muted: boolean) => {
      video.muted = muted;
      video.defaultMuted = muted;
      if (muted) video.setAttribute('muted', '');
      else {
        video.removeAttribute('muted');
        video.volume = 1;
      }
      syncSoundUi();
    };

    const tryPlay = async () => {
      if (wantsSound) {
        setMuted(false);
        try {
          await video.play();
          return;
        } catch {
          /* El navegador bloquea el audio automático: el vídeo sigue y el sonido entra con el primer gesto. */
        }
      }

      setMuted(true);
      try {
        await video.play();
      } catch {
        /* Autoplay bloqueado. */
      }
    };

    const unlockSound = () => {
      if (!wantsSound || !video.muted) return;
      setMuted(false);
      void video.play();
    };

    video.volume = 1;
    setMuted(!wantsSound);
    void tryPlay();

    const unlockEvents = ['pointerdown', 'keydown', 'touchstart'] as const;
    const onFirstGesture = () => {
      unlockSound();
      unlockEvents.forEach((type) => {
        window.removeEventListener(type, onFirstGesture, true);
      });
    };
    unlockEvents.forEach((type) => {
      window.addEventListener(type, onFirstGesture, { capture: true });
    });

    soundBtn.addEventListener('click', (event) => {
      event.stopPropagation();
      wantsSound = !wantsSound;
      setMuted(!wantsSound);
      if (wantsSound) void video.play();
    });

    video.addEventListener('volumechange', syncSoundUi);
    syncSoundUi();
  }
</script>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: max(0.7rem, env(safe-area-inset-top)) var(--spacing-gutter) 0.7rem;
    background: color-mix(in srgb, var(--color-canvas) 72%, transparent);
    backdrop-filter: blur(16px);
  }

  :global(.is-overlay) .masthead {
    position: fixed;
    inset-inline: 0;
    background: linear-gradient(
      to bottom,
      rgba(10, 9, 6, 0.88) 0%,
      rgba(10, 9, 6, 0.55) 55%,
      rgba(10, 9, 6, 0.18) 100%
    );
    backdrop-filter: blur(12px);
  }

  :global(.is-overlay) .masthead.is-solid,
  :global(.is-overlay) .masthead.is-open {
    background: var(--color-canvas);
    backdrop-filter: none;
  }

  .mast-links {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem 1.6rem;
  }

  .brand,
  .mast-mail,
  .menu-toggle,
  .nav-section-toggle,
  nav a {
    text-decoration: none;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .brand img {
    display: block;
    width: clamp(4.25rem, 9vw, 5.35rem);
    height: auto;
  }

  .mast-mail,
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: 0.18em;
    line-height: 1;
    text-transform: uppercase;
  }

  .mast-actions {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 2vw, 1.15rem);
  }

  .mast-rule {
    width: 1px;
    height: 0.9rem;
    background: rgba(255, 255, 255, 0.45);
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font-family: inherit;
    cursor: pointer;
  }

  .audio-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    font-family: inherit;
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: 0.18em;
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
  }

  .audio-toggle:hover,
  .audio-toggle:focus-visible,
  .audio-toggle.is-live {
    color: #fff;
  }

  .audio-toggle__dot {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .audio-toggle__dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: currentColor;
    opacity: 0;
  }

  .audio-toggle.is-live .audio-toggle__dot::after {
    animation: ping 1.6s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  .audio-toggle__label {
    display: none;
  }

  .audio-toggle__icon {
    display: none;
    width: 14px;
    height: 14px;
  }

  .audio-toggle:not(.is-live) .audio-toggle__icon--off,
  .audio-toggle.is-live .audio-toggle__icon--on {
    display: block;
  }

  @keyframes ping {
    75%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  @media (min-width: 720px) {
    .audio-toggle__label {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .audio-toggle.is-live .audio-toggle__dot::after {
      animation: none;
    }
  }

  .label-close {
    display: none;
  }

  .is-open .label-open {
    display: none;
  }

  .is-open .label-close {
    display: inline;
  }

  nav {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    padding: clamp(5.25rem, 12vh, 7.5rem) var(--spacing-gutter) max(2.5rem, env(safe-area-inset-bottom));
    background: var(--color-canvas);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  nav[hidden] {
    display: none;
  }

  .primary-nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a,
  .nav-section-toggle {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: clamp(1.12rem, 2.05vw, 1.62rem);
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .nav-section-toggle {
    gap: 0.65rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .nav-section-toggle svg {
    width: 0.85rem;
    height: 0.85rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.25;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-section-toggle[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .nav-group.is-current > .nav-section-toggle {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .nav-submenu {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
    margin: 0.15rem 0 0.55rem;
    padding: 0 0 0 clamp(0.85rem, 2vw, 1.5rem);
    border-left: 1px solid rgba(255, 255, 255, 0.28);
    list-style: none;
  }

  .nav-submenu[hidden] {
    display: none;
  }

  .nav-submenu a {
    min-height: 44px;
    color: rgba(255, 255, 255, 0.72);
    font-size: clamp(0.76rem, 1.15vw, 0.92rem);
    letter-spacing: 0.11em;
  }

  .nav-submenu a:hover,
  .nav-submenu a:focus-visible,
  .nav-submenu a[aria-current='page'] {
    color: #fff;
  }

  .is-open nav a,
  .is-open .nav-section-toggle {
    animation: nav-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .is-open .primary-nav > li:nth-child(2) > :first-child { animation-delay: 0.04s; }
  .is-open .primary-nav > li:nth-child(3) > :first-child { animation-delay: 0.08s; }
  .is-open .primary-nav > li:nth-child(4) > :first-child { animation-delay: 0.12s; }
  .is-open .primary-nav > li:nth-child(5) > :first-child { animation-delay: 0.16s; }
  .is-open .primary-nav > li:nth-child(6) > :first-child { animation-delay: 0.2s; }
  .is-open .primary-nav > li:nth-child(7) > :first-child { animation-delay: 0.24s; }
  @keyframes nav-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  @media (max-width: 720px) {
    .mast-mail {
      display: none;
    }
  }

  @media (max-height: 740px) {
    nav {
      padding-top: 5rem;
      padding-bottom: max(1.25rem, env(safe-area-inset-bottom));
    }

    nav a,
    .nav-section-toggle {
      min-height: 44px;
      font-size: 1.3rem;
    }

    .primary-nav {
      gap: 0.15rem;
    }

    .nav-submenu a {
      min-height: 44px;
      font-size: 0.78rem;
    }
  }
</style>
