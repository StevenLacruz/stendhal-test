---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { menuHref, menuSections } from '../../data/menu';

export function getStaticPaths() {
  return menuSections.map((section, index) => ({
    params: { slug: section.slug },
    props: { index },
  }));
}

interface Props {
  index: number;
}

const { index } = Astro.props;
const section = menuSections[index];
const next = menuSections[(index + 1) % menuSections.length];

if (!section || !next) {
  throw new Error('Sección de menú sin datos.');
}
---

<BaseLayout title={section.seoTitle} description={section.seoDescription} path={menuHref(section.slug)} overlay>
  <main id="contenido">
    <header class="hero">
      <img
        src={section.image.src}
        width={section.image.width}
        height={section.image.height}
        alt={section.image.alt}
        decoding="async"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-copy">
        <h1>{section.title}</h1>
        <div class="hero-lede">
          {section.lede.map((text) => <p>{text}</p>)}
        </div>
        <nav class="act-nav" aria-label={`Propuestas de ${section.title}`}>
          <ul>
            {section.acts.map((act) => (
              <li><a href={`#${act.id}`}>{act.title}</a></li>
            ))}
          </ul>
        </nav>
      </div>
      <a class="scroll-cue" href={`#${section.acts[0]?.id}`} aria-label="Explorar propuestas">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 4v15M6.5 13.5 12 19l5.5-5.5" />
        </svg>
      </a>
    </header>

    <div class="gallery">
      {
        section.acts.map((act, actIndex) => {
          const mainImage = act.image;

          return (
            <article
              class:list={['act', actIndex % 2 === 1 && 'is-reversed']}
              id={act.id}
              data-reveal
            >
              <figure class="primary-media">
                <img
                  src={mainImage.src}
                  width={mainImage.width}
                  height={mainImage.height}
                  alt={mainImage.alt}
                  decoding="async"
                  loading="lazy"
                />
              </figure>
              <div class="act-copy">
                <h2>{act.title}</h2>
                {act.texts.map((text) => <p>{text}</p>)}
                {act.note && <p class="note">{act.note}</p>}
                <a class="contact-link" href="/#formulario">
                  <span>Consultar esta propuesta</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 12h15M13.5 6.5 19 12l-5.5 5.5" />
                  </svg>
                </a>
              </div>
            </article>
          );
        })
      }
    </div>

    <aside class="next">
      <a href={menuHref(next.slug)}>
        <span class="next-image" aria-hidden="true">
          <img
            src={next.image.src}
            width={next.image.width}
            height={next.image.height}
            alt=""
            decoding="async"
            loading="lazy"
          />
        </span>
        <span class="next-copy">
          <strong>{next.title}</strong>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 12h15M13.5 6.5 19 12l-5.5 5.5" />
          </svg>
        </span>
      </a>
    </aside>
  </main>
</BaseLayout>

<script>
  const items = document.querySelectorAll<HTMLElement>('[data-reveal]');

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -12% 0px', threshold: 0.12 },
    );

    for (const item of items) observer.observe(item);
  } else {
    for (const item of items) item.classList.add('is-visible');
  }
</script>

<style>
  main {
    background: var(--color-canvas);
  }

  .hero {
    position: relative;
    display: grid;
    min-height: 100dvh;
    align-items: end;
    overflow: hidden;
    background: var(--color-canvas);
  }

  .hero > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    animation: hero-in 1.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(0, 0, 0, 0.58) 0%, transparent 25%),
      linear-gradient(to top, #000 0%, rgba(0, 0, 0, 0.76) 27%, rgba(0, 0, 0, 0.12) 66%);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: end;
    padding: clamp(7rem, 17vh, 10rem) var(--spacing-gutter) clamp(4.5rem, 9vh, 6.5rem);
  }

  h1,
  h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
  }

  h1 {
    max-width: 13ch;
    font-size: clamp(2.5rem, 6.8vw, 7.4rem);
    letter-spacing: 0.045em;
    line-height: 0.94;
  }

  .hero-lede {
    align-self: end;
  }

  .hero-lede p {
    max-width: 34rem;
    margin: 0;
    color: rgba(255, 255, 255, 0.88);
    font-size: clamp(1rem, 1.25vw, 1.18rem);
    line-height: 1.55;
  }

  .hero-lede p + p {
    margin-top: 0.8rem;
  }

  .act-nav {
    grid-column: 1 / -1;
    padding-top: clamp(1.25rem, 3vh, 2rem);
    border-top: 1px solid rgba(255, 255, 255, 0.45);
  }

  .act-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem clamp(1rem, 3vw, 2.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .act-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    line-height: 1.35;
    text-decoration: none;
    text-transform: uppercase;
  }

  .act-nav a:hover,
  .act-nav a:focus-visible {
    color: #fff;
  }

  .scroll-cue {
    position: absolute;
    right: var(--spacing-gutter);
    bottom: 1rem;
    z-index: 2;
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.48);
    border-radius: 50%;
    text-decoration: none;
  }

  .scroll-cue svg,
  .next-copy svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.35;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .gallery {
    padding: clamp(4rem, 10vw, 9rem) var(--spacing-gutter);
    overflow: hidden;
  }

  .act {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    min-height: min(86vh, 58rem);
    align-items: center;
    scroll-margin-top: 4.75rem;
  }

  .act + .act {
    margin-top: clamp(7rem, 17vw, 15rem);
  }

  .primary-media {
    grid-column: 1 / span 8;
    grid-row: 1;
    height: min(78vh, 52rem);
    margin: 0;
    overflow: hidden;
    background: color-mix(in srgb, var(--color-canvas) 86%, #fff);
  }

  .primary-media img,
  .next-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .act-copy {
    position: relative;
    z-index: 2;
    grid-column: 7 / -1;
    grid-row: 1;
    align-self: end;
    margin-bottom: clamp(2rem, 7vh, 5rem);
    padding: clamp(1.5rem, 3.5vw, 3rem);
    background: color-mix(in srgb, var(--color-canvas) 94%, transparent);
  }

  .is-reversed .primary-media {
    grid-column: 5 / -1;
  }

  .is-reversed .act-copy {
    grid-column: 1 / span 6;
  }

  h2 {
    max-width: 15ch;
    font-size: clamp(1.85rem, 4.2vw, 4.5rem);
    letter-spacing: 0.055em;
    line-height: 0.98;
  }

  .act-copy p {
    max-width: 37rem;
    margin: 1rem 0 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: clamp(0.98rem, 1.15vw, 1.12rem);
    line-height: 1.58;
  }

  .act-copy p + p {
    margin-top: 0.75rem;
  }

  .act-copy .note {
    color: #fff;
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 44px;
    margin-top: 1.5rem;
    padding: 0.8rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.68);
    color: #fff;
    font-size: 0.74rem;
    letter-spacing: 0.15em;
    line-height: 1.4;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }

  .contact-link svg {
    flex: 0 0 auto;
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact-link:hover,
  .contact-link:focus-visible {
    border-color: #fff;
    background: #fff;
    color: var(--color-canvas);
  }

  .contact-link:hover svg,
  .contact-link:focus-visible svg {
    transform: translateX(0.3rem);
  }

  [data-reveal] .primary-media,
  [data-reveal] .act-copy {
    opacity: 0;
    transform: translateY(2.25rem);
    transition:
      opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
  }

  [data-reveal] .act-copy {
    transition-delay: 0.12s;
  }

  [data-reveal].is-visible .primary-media,
  [data-reveal].is-visible .act-copy {
    opacity: 1;
    transform: none;
  }

  .next {
    margin: 0;
    padding: 0 var(--spacing-gutter) clamp(4rem, 9vh, 7rem);
  }

  .next > a {
    position: relative;
    display: grid;
    min-height: min(55vh, 34rem);
    align-items: end;
    overflow: hidden;
    text-decoration: none;
  }

  .next-image {
    position: absolute;
    inset: 0;
  }

  .next > a::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.9), rgba(0, 0, 0, 0.08) 70%);
  }

  .next-copy {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.5rem;
    align-items: end;
    padding: clamp(1.5rem, 4vw, 3rem);
  }

  .next-copy strong {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 4vw, 4rem);
    font-weight: 400;
    letter-spacing: 0.06em;
    line-height: 1;
    text-transform: uppercase;
  }

  .next-copy svg {
    width: clamp(2rem, 4vw, 3.5rem);
    height: clamp(2rem, 4vw, 3.5rem);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .next > a:hover .next-copy svg {
    transform: translateX(0.5rem);
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: scale(1.08);
    }
    to {
      opacity: 1;
      transform: scale(1.02);
    }
  }

  @media (max-width: 760px) {
    .hero {
      min-height: 100svh;
    }

    .hero-copy {
      grid-template-columns: 1fr;
      gap: 1rem;
      padding-top: 7rem;
      padding-bottom: 5rem;
    }

    h1 {
      font-size: clamp(2.5rem, 12vw, 4.25rem);
    }

    .act-nav {
      grid-column: 1;
    }

    .act-nav ul {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
    }

    .scroll-cue {
      display: none;
    }

    .gallery {
      padding-top: 5rem;
      padding-bottom: 6rem;
    }

    .act,
    .act.is-reversed {
      display: flex;
      min-height: auto;
      flex-direction: column;
      align-items: stretch;
    }

    .act + .act {
      margin-top: 7rem;
    }

    .primary-media,
    .is-reversed .primary-media {
      width: calc(100% + var(--spacing-gutter) * 2);
      height: min(68svh, 38rem);
      margin-inline: calc(var(--spacing-gutter) * -1);
    }

    .act-copy,
    .is-reversed .act-copy {
      width: calc(100% - 1.5rem);
      margin: -1.5rem 0 0;
      padding: 1.5rem 0 0;
      background: var(--color-canvas);
    }

    h2 {
      font-size: clamp(2rem, 10vw, 3.5rem);
    }

    .next {
      padding-inline: 0;
      padding-bottom: 0;
    }

    .next > a {
      min-height: 62svh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero > img,
    [data-reveal] .primary-media,
    [data-reveal] .act-copy {
      animation: none;
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
