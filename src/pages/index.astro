---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getHome, getSettings } from '../lib/content';

const home = await getHome();
const settings = await getSettings();
const { headline, subheadline, about, seoTitle, seoDescription } = home.data;
const year = new Date().getFullYear();
const mail = `mailto:${settings.data.email}`;
const instagram = settings.data.socials.find((social) => social.href.includes('instagram.com'));
const organizationId = new URL('/#organization', Astro.site).toString();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: settings.data.siteName,
    url: Astro.site?.toString(),
    email: settings.data.email,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: settings.data.siteName,
    url: Astro.site?.toString(),
    publisher: { '@id': organizationId },
  },
];

const artists = [
  {
    title: 'Music',
    text: 'Bandas · DJs · cantantes · orquestas · músicos',
    src: '/media/cantante.jpg',
    alt: 'Cantante con vestido de flecos dorados, en un escenario.',
  },
  {
    title: 'Dance',
    text: 'Flamenco · urbano · contemporáneo · coreografías',
    src: '/media/conjunto.jpg',
    alt: 'Cortejo de flamenco y zancos en un jardín.',
  },
  {
    title: 'Show',
    text: 'Performances · acrobacia · magia · humor · circo',
    src: '/media/casa.jpg',
    alt: 'Tres performers bajo un neón rosa, en un escenario.',
  },
  {
    title: 'Visual',
    text: 'LED · mapping · audiovisuales · iluminación',
    src: '/media/banda.jpg',
    alt: 'Banda en directo frente a una pantalla de escenario.',
  },
  {
    title: 'Talent',
    text: 'Presentadores · artistas · celebrities · influencers',
    src: '/media/mascaras.jpg',
    alt: 'Tres personajes de cine en una entrega de premios.',
  },
  {
    title: 'Immersive',
    text: 'Experiencias diseñadas específicamente para cada evento',
    src: '/media/zancos.jpg',
    alt: 'Artista sobre zancos, con traje lila, brindando.',
  },
];

const concepts = [
  {
    text: 'Unos camareros infiltrados en una cena como artistas.',
    src: '/media/salon.jpg',
    alt: 'Salón de celebración con lámparas de araña y copas.',
  },
  {
    text: 'Un espectáculo que aparece desde el techo.',
    src: '/media/escalera.jpg',
    alt: 'Compañía de flamenco en la escalera de un hotel.',
  },
  {
    text: 'Una cena que se convierte en un show.',
    src: '/media/epoca.jpg',
    alt: 'Cortejo de época junto a una pared de máscaras.',
  },
  {
    text: 'Un artista internacional cerrando una convención.',
    src: '/media/solista.jpg',
    alt: 'Solista con vestido dorado en un club.',
  },
  {
    text: 'Una experiencia audiovisual creada exclusivamente para tu marca.',
    src: '/media/voces.jpg',
    alt: 'Voces en un escenario bañado de luz azul.',
  },
];

const paths = [
  {
    title: 'Sé qué evento tengo',
    text: 'Quiero organizar un evento',
    src: '/media/palace.jpg',
    alt: 'Vestíbulo de un hotel con un recibimiento de tocados y plumas.',
  },
  {
    title: 'Sé lo que quiero conseguir',
    text: 'Quiero sorprender / emocionar / cerrar con impacto.',
    src: '/media/escalinata.jpg',
    alt: 'Vestido rojo bajando una escalinata de piedra al aire libre.',
  },
  {
    title: 'No tengo ni idea',
    text: 'Inspírame.',
    src: '/media/jardin.jpg',
    alt: 'Zancos y vestuario de flamenco en un jardín.',
  },
];

const logos = [
  { src: '/logos/repsol.svg', alt: 'Repsol' },
  { src: '/logos/elle-education.svg', alt: 'Elle Education' },
  { src: '/logos/la-liga.svg', alt: 'LaLiga' },
  { src: '/logos/telepizza.svg', alt: 'Telepizza' },
  { src: '/logos/loreal.svg', alt: "L'Oréal" },
  { src: '/logos/yves-saint-laurent.svg', alt: 'Yves Saint Laurent' },
  { src: '/logos/el-corte-ingles.svg', alt: 'El Corte Inglés' },
  { src: '/logos/audi.svg', alt: 'Audi' },
  { src: '/logos/renault.svg', alt: 'Renault' },
  { src: '/logos/astrazeneca.svg', alt: 'AstraZeneca' },
  { src: '/logos/nestle.svg', alt: 'Nestlé' },
  { src: '/logos/johnson-johnson.svg', alt: 'Johnson & Johnson' },
  { src: '/logos/ilunion-hotels.svg', alt: 'Ilunion Hotels' },
  { src: '/logos/ey.svg', alt: 'EY' },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  path="/"
  jsonLd={jsonLd}
  overlay
  showFooter={false}
>
  <main>
    <section class="frame hero" id="inicio">
      <video
        autoplay
        muted
        loop
        playsinline
        poster="/media/showreel-poster.jpg"
        width="1920"
        height="1080"
        data-hero-video
      >
        <source src="/media/showreel.mp4" type="video/mp4" />
      </video>
      <div class="hero-copy">
        <h1>
          <span>Hacemos que los</span>
          <span>eventos sucedan</span>
        </h1>
        <p class="hero-sub">{subheadline}</p>
        <a class="pill hero-cta" href="#formulario">Cuéntanos tu evento</a>
      </div>
      <span class="sweep" aria-hidden="true"></span>
    </section>

    <section class="frame wordmark">
      <img
        src="/media/guitarra.jpg"
        width="2200"
        height="1166"
        alt="Guitarrista en un escenario con humo y luces rojas."
      />
      <p class="lockup">
        <span>Hay momentos que</span>
        <span>se viven y otros</span>
        <span>que se recuerdan</span>
      </p>
    </section>

    <section class="sheet" id="artistas" aria-labelledby="artistas-titulo">
      <p class="eyebrow center">Artistas</p>
      <h2 id="artistas-titulo" class="display center">
        <span>¿Qué podemos</span>
        <span>hacer?</span>
      </h2>
      <ul class="tiles acts">
        {
          artists.map((item) => (
            <li>
              <a class="tile" href="#formulario" data-intent={item.title}>
                <img src={item.src} width="2200" height="1460" alt={item.alt} />
                <span class="tile-copy">
                  <strong>{item.title}</strong>
                  <span>{item.text}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="pill" href="#inspirate">Descubrir todas las posibilidades →</a>
    </section>

    <section class="logo-marquee" aria-label="Empresas que confían en nosotros" tabindex="0">
      <p class="eyebrow logos-label">Empresas que confían en nosotros</p>
      <div class="logo-track">
        {
          [0, 1].map((copy) => (
            <ul class:list={['logo-set', copy === 1 && 'is-clone']} aria-hidden={copy === 1 ? 'true' : undefined}>
              {logos.map((logo) => (
                <li>
                  <img src={`${logo.src}?v=2`} alt={copy === 0 ? logo.alt : ''} width="160" height="48" loading="lazy" />
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </section>

    <a
      class="bleed instagram-band"
      href={instagram?.href ?? 'https://www.instagram.com/elefectostendhal'}
      target="_blank"
      rel="noopener noreferrer"
    >
      <img
        src="/media/farol.jpg"
        width="2200"
        height="1467"
        alt=""
        loading="lazy"
      />
      <span class="instagram-copy">
        <span class="display"><span>Instagram</span></span>
        <span class="micro">Síguenos</span>
      </span>
    </a>

    <section class="sheet" id="sobre">
      <h2 class="display">
        <span>Hay momentos</span>
        <span>que se viven.</span>
      </h2>
      <p class="display follow">
        <span>Y otros</span>
        <span>que se recuerdan.</span>
      </p>
      <p class="lede">{about}</p>
    </section>

    <figure class="bleed video-bleed">
      <video
        muted
        loop
        playsinline
        poster="/media/flamenco-poster.jpg"
        width="1280"
        height="864"
        data-flamenco
      >
        <source src="/media/flamenco.mp4" type="video/mp4" />
      </video>
    </figure>

    <section class="sheet productions" id="producciones">
      <p class="pill">Producciones</p>
      <h2 class="display center">
        <span>Producciones</span>
      </h2>
      <div class="mosaic">
        <img
          src="/media/cuerdas.jpg"
          width="2200"
          height="1465"
          alt="Músicos de cuerda con vestuario de época."
          loading="lazy"
        />
        <img
          src="/media/crucero.jpg"
          width="2200"
          height="1464"
          alt="Bailarina en un pasillo rojo, ante una pantalla de presentación."
          loading="lazy"
        />
        <img
          src="/media/conferencia.jpg"
          width="2200"
          height="1466"
          alt="Presentación en un auditorio, con una gran pantalla detrás."
          loading="lazy"
        />
      </div>
    </section>

    <section class="sheet" id="a-medida">
      <p class="eyebrow">A medida</p>
      <h2 class="display">
        <span>Eventos</span>
        <span>a medida</span>
      </h2>
      <p class="lede">¿Tienes una idea? Nosotros la hacemos realidad.</p>
      <p class="lede quiet">
        No trabajamos con fórmulas cerradas. Diseñamos propuestas artísticas a medida de cada evento,
        espacio, público y objetivo.
      </p>
      <h3 class="display follow">
        <span>Imagina.</span>
      </h3>
      <ul class="tiles concepts">
        {
          concepts.map((item) => (
            <li>
              <figure class="tile">
                <img src={item.src} width="2200" height="1460" alt={item.alt} loading="lazy" />
                <figcaption class="tile-copy">
                  <span>{item.text}</span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="sheet inspire" id="inspirate">
      <h2 class="display center">
        <span>Inspírate</span>
      </h2>
      <p class="micro">Revista visual. Imágenes y vídeos. Resumen de eventos.</p>
      <div class="reel">
        <ul class="reel-track" tabindex="0" aria-label="Imágenes para inspirarte">
          <li>
            <img src="/media/patio.jpg" width="2200" height="1650" alt="Cola roja sobre la piedra de un patio, a plena luz." loading="lazy" />
          </li>
          <li>
            <img src="/media/abanicos.jpg" width="2200" height="1650" alt="Tres bailaoras con abanicos rojos en una escalera." loading="lazy" />
          </li>
          <li>
            <img src="/media/tenor.jpg" width="2200" height="1467" alt="Cantante con esmoquin y pajarita, en un escenario." loading="lazy" />
          </li>
          <li>
            <img src="/media/alas.jpg" width="2200" height="1465" alt="Alas de luz y un personaje en una presentación." loading="lazy" />
          </li>
        </ul>
        <button class="reel-btn is-prev" type="button" data-reel-prev aria-label="Imagen anterior">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path d="M14.5 5.5 8 12l6.5 6.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button class="reel-btn is-next" type="button" data-reel-next aria-label="Imagen siguiente">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path d="M9.5 5.5 16 12l-6.5 6.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </section>

    <section class="sheet closer" id="contacto" aria-labelledby="contacto-titulo">
      <p class="eyebrow center">Contacto</p>
      <h2 id="contacto-titulo" class="display center">
        <span>Cuéntanos qué</span>
        <span>quieres hacer.</span>
      </h2>
      <p class="lede center">Nosotros pensamos cómo hacerlo.</p>
      <ul class="paths">
        {
          paths.map((item, i) => (
            <li>
              <a class="tile path" href="#formulario" data-intent={item.text}>
                <img src={item.src} width="2200" height="1460" alt="" loading="lazy" />
                <span class="tile-copy">
                  <span class="path-n">{String(i + 1).padStart(2, '0')}</span>
                  <strong>{item.title}</strong>
                  <span>{item.text}</span>
                  <span class="path-go" aria-hidden="true">→</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="pill" href="#formulario">Hablemos de tu evento →</a>
    </section>

    <section class="sheet contact" id="formulario">
      <div>
        <h2 class="display">
          <span>Cuéntanos</span>
          <span>tu evento</span>
        </h2>
        <p class="talk">Formulario evento</p>
        <form data-proposal action={mail} method="post">
          <p class="eyebrow" data-intent-label hidden></p>
          <input type="hidden" name="intencion" data-intent-field value="" />
          <label>
            Nombre
            <input name="nombre" type="text" autocomplete="name" required />
          </label>
          <label>
            Email
            <input name="email" type="email" autocomplete="email" required />
          </label>
          <label>
            Teléfono
            <input name="telefono" type="tel" autocomplete="tel" />
          </label>
          <label>
            Mensaje
            <textarea name="mensaje" rows="4" required></textarea>
          </label>
          <button class="pill" type="submit">Cuéntanos tu evento</button>
        </form>
      </div>
    </section>

    <footer class="colophon">
      <a class="foot-logo" href="#inicio">
        <img src="/brand/logo.png" width="937" height="542" alt="El Efecto Stendhal" />
      </a>
      <a class="mail" href={mail}>{settings.data.email}</a>
      <p class="tag">{headline}</p>
      <p class="legal"><small>© {year} {settings.data.siteName}</small></p>
    </footer>
  </main>
</BaseLayout>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const heroVideo = document.querySelector('[data-hero-video]');
  const flamenco = document.querySelector('[data-flamenco]');

  if (heroVideo instanceof HTMLVideoElement) {
    if (reduce) {
      heroVideo.pause();
    } else {
      if ('IntersectionObserver' in window) {
        const heroObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) heroVideo.play();
              else heroVideo.pause();
            });
          },
          { threshold: 0.35 },
        );
        heroObserver.observe(heroVideo);
      }
    }
  }

  if (flamenco instanceof HTMLVideoElement) {
    if (reduce) {
      flamenco.pause();
    } else if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) flamenco.play();
            else flamenco.pause();
          });
        },
        { threshold: 0.35 },
      );
      observer.observe(flamenco);
    }
  }

  document.querySelectorAll('[data-intent]').forEach((link) => {
    link.addEventListener('click', () => {
      const value = link.getAttribute('data-intent') ?? '';
      const field = document.querySelector('[data-intent-field]');
      const label = document.querySelector('[data-intent-label]');
      if (field instanceof HTMLInputElement) field.value = value;
      if (label instanceof HTMLElement) {
        label.hidden = value.length === 0;
        label.textContent = value;
      }
    });
  });

  const reel = document.querySelector('.reel-track');
  const reelPrev = document.querySelector('[data-reel-prev]');
  const reelNext = document.querySelector('[data-reel-next]');
  if (reel instanceof HTMLElement && reelPrev instanceof HTMLButtonElement && reelNext instanceof HTMLButtonElement) {
    const slides = [...reel.querySelectorAll(':scope > li')];
    let index = 0;
    let reelTimer = 0;
    const readIndex = () => {
      const origin = slides[0] instanceof HTMLElement ? slides[0].offsetLeft : 0;
      let nearest = 0;
      let best = Infinity;
      slides.forEach((slide, i) => {
        if (!(slide instanceof HTMLElement)) return;
        const distance = Math.abs(slide.offsetLeft - origin - reel.scrollLeft);
        if (distance < best) {
          best = distance;
          nearest = i;
        }
      });
      index = nearest;
    };
    const go = (next) => {
      if (!slides.length) return;
      index = (next + slides.length) % slides.length;
      const slide = slides[index];
      const origin = slides[0];
      if (!(slide instanceof HTMLElement) || !(origin instanceof HTMLElement)) return;
      reel.scrollTo({
        left: slide.offsetLeft - origin.offsetLeft,
        behavior: reduce ? 'auto' : 'smooth',
      });
    };
    const stopReel = () => window.clearInterval(reelTimer);
    const startReel = () => {
      stopReel();
      if (document.hidden || slides.length < 2) return;
      reelTimer = window.setInterval(() => go(index + 1), 3200);
    };
    reelPrev.addEventListener('click', () => {
      go(index - 1);
      startReel();
    });
    reelNext.addEventListener('click', () => {
      go(index + 1);
      startReel();
    });
    reel.addEventListener('scrollend', readIndex);
    reel.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        go(index + 1);
        startReel();
      }
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        go(index - 1);
        startReel();
      }
    });
    reel.addEventListener('pointerdown', stopReel);
    reel.addEventListener('pointerup', () => window.setTimeout(startReel, 2800));
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopReel();
      else startReel();
    });
    startReel();
  }

  const form = document.querySelector('[data-proposal]');
  if (form instanceof HTMLFormElement) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const nombre = String(data.get('nombre') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const telefono = String(data.get('telefono') ?? '').trim();
      const mensaje = String(data.get('mensaje') ?? '').trim();
      const intencion = String(data.get('intencion') ?? '').trim();
      const lines = [`Nombre: ${nombre}`, `Email: ${email}`];
      if (telefono) lines.push(`Teléfono: ${telefono}`);
      if (intencion) lines.push(`Intención: ${intencion}`);
      lines.push('', mensaje);
      const body = lines.join('\n');
      const href = `mailto:eventos@elefectostendhal.com?subject=${encodeURIComponent('Propuesta')}&body=${encodeURIComponent(body)}`;
      window.location.href = href;
    });
  }
</script>

<style>
  main {
    background: #000;
  }

  .frame {
    position: relative;
    display: grid;
    min-height: 100dvh;
    place-items: center;
    overflow: hidden;
    color: #fff;
  }

  .hero {
    place-items: end start;
    padding: 0 var(--spacing-gutter) clamp(1.75rem, 4vh, 2.75rem);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    max-width: min(42rem, 100%);
    isolation: isolate;
  }

  .hero-copy::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -1rem -12% -1.25rem -8%;
    background: radial-gradient(
      ellipse at 12% 72%,
      rgba(0, 0, 0, 0.78) 0%,
      rgba(0, 0, 0, 0.4) 50%,
      transparent 74%
    );
    pointer-events: none;
  }

  .hero-sub {
    max-width: 28rem;
    margin: 0;
    color: #fff;
    font-size: 1rem;
    line-height: 1.5;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.85);
  }

  .frame img,
  .frame video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero video {
    transform-origin: center;
    animation: hero-drift 22s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .sweep {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      105deg,
      transparent 42%,
      rgba(255, 255, 255, 0.22) 50%,
      transparent 58%
    );
    transform: translateX(-130%);
    animation: sweep 1.7s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
  }

  .frame::after,
  .bleed::after,
  .plate::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, #000 0%, rgba(0, 0, 0, 0.62) 16%, transparent 40%),
      linear-gradient(to top, #000 0%, rgba(0, 0, 0, 0.82) 20%, transparent 54%);
  }

  .frame::after {
    background:
      linear-gradient(to bottom, #000 0%, rgba(0, 0, 0, 0.42) 12%, transparent 32%),
      linear-gradient(to top, #000 0%, rgba(0, 0, 0, 0.55) 14%, transparent 40%);
  }

  .hero::after {
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.72) 0%,
      rgba(0, 0, 0, 0.28) 18%,
      transparent 42%
    );
  }

  .frame::after {
    z-index: 0;
  }

  .bleed::after,
  .plate::before {
    z-index: 1;
  }

  .lockup,
  h1,
  .display {
    position: relative;
    z-index: 1;
    margin: 0;
    font-weight: 400;
    letter-spacing: 0.06em;
    line-height: 1.14;
    text-transform: uppercase;
    text-wrap: unset;
  }

  .lockup span,
  h1 span,
  .display span {
    display: block;
  }

  .lockup {
    font-family: "Instrument Serif", Palatino, "Palatino Linotype", Georgia, serif;
    font-size: clamp(2.5rem, 1.15rem + 3.4vw, 4.6rem);
    font-weight: 400;
    line-height: 0.96;
    letter-spacing: 0;
    text-align: center;
    text-transform: none;
    text-shadow: 0 0.08em 0.28em rgba(0, 0, 0, 0.85);
    isolation: isolate;
  }

  .lockup::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -18% -12%;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.62) 0%, transparent 72%);
    pointer-events: none;
  }

  h1 {
