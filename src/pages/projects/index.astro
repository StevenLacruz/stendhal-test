---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, getSettings } from '../../lib/content';

const settings = await getSettings();
const projects = await getProjects();
---

<BaseLayout
  title={settings.data.projectsTitle}
  description={settings.data.projectsDescription}
  path="/projects"
>
  <main id="contenido">
    <header>
      <h1>{settings.data.projectsHeading}</h1>
    </header>
    {
      projects.length === 0 ? (
        <p>{settings.data.projectsEmpty}</p>
      ) : (
        <div class="grid">
          {projects.map((project, index) => (
            <ProjectCard project={project} eager={index === 0} />
          ))}
        </div>
      )
    }
  </main>
</BaseLayout>

<style>
  main {
    padding: clamp(2rem, 6vw, 4rem) var(--spacing-gutter) 6rem;
  }

  h1 {
    max-width: 10em;
    margin: 0 0 clamp(3rem, 10vh, 7rem);
    font-size: clamp(2.75rem, 7vw, 5.5rem);
  }

  p {
    max-width: 36rem;
    color: var(--color-muted);
  }

  .grid {
    display: flex;
    flex-direction: column;
    gap: 18vh;
  }
</style>
